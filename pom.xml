<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bruhnerd</groupId>
  <artifactId>placedonlybreak</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>PlacedOnlyBreak</name>
  <description>Restricts block breaking in WorldGuard regions to player-placed blocks, verified via CoreProtect.</description>

  <licenses>
    <license>
      <name>GPL-3.0-or-later</name>
      <url>https://www.gnu.org/licenses/gpl-3.0.html</url>
    </license>
  </licenses>

  <properties>
    <!-- Compile against the OLDEST supported APIs (MC 1.13.2, CoreProtect 2.16; WG 7.0.5/WE 7.2.5 are the
         oldest that still resolve, and the WG API used here is unchanged since 7.0.0) on Java 8.
         Newer servers stay backwards compatible with these, so one jar runs on 1.13.2 through 26.x. -->
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <repositories>
    <!-- Spigot API (Paper no longer hosts its pre-1.16 API artifacts) -->
    <repository>
      <id>spigotmc</id>
      <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
    </repository>

    <!-- EngineHub (WorldEdit/WorldGuard) -->
    <repository>
      <id>enginehub</id>
      <url>https://maven.enginehub.org/repo/</url>
    </repository>

    <!-- CoreProtect -->
    <repository>
      <id>playpro</id>
      <url>https://maven.playpro.com</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Spigot API (runs on Spigot and Paper) -->
    <dependency>
      <groupId>org.spigotmc</groupId>
      <artifactId>spigot-api</artifactId>
      <version>1.13.2-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- WorldGuard -->
    <dependency>
      <groupId>com.sk89q.worldguard</groupId>
      <artifactId>worldguard-bukkit</artifactId>
      <version>7.0.5</version>
      <scope>provided</scope>
    </dependency>

    <!-- WorldEdit (WorldGuard depends on it at compile-time sometimes) -->
    <dependency>
      <groupId>com.sk89q.worldedit</groupId>
      <artifactId>worldedit-bukkit</artifactId>
      <version>7.2.5</version>
      <scope>provided</scope>
    </dependency>

    <!-- CoreProtect -->
    <dependency>
      <groupId>net.coreprotect</groupId>
      <artifactId>coreprotect</artifactId>
      <version>2.16.0</version>
      <scope>provided</scope>
      <exclusions>
        <!-- Its pom drags in dead WorldEdit/Bukkit snapshots; we only need CoreProtect's own API classes -->
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Fills ${project.version} in plugin.yml -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- Make sure we build a normal plugin jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
